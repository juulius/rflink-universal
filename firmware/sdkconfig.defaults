# RFLink Universal ESP32-S3-WROOM-1-N16R8 (16 MB Quad flash, 8 MB Octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# app_main performs persistent core-dump summary/NVS boot history, bounded
# PSRAM log allocation, startup diagnostics and radio/OTA initialization.
# ESP-IDF's small default main stack is not suitable for this call chain;
# reserve explicit internal stack headroom and measure it during boot.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Crash reporting is mandatory in v0.7, not an optional debug-only build.
# ELF + SHA256 supports reading the crash task/PC after the ESP32 reboots.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_SHA256=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=12
CONFIG_ESP_COREDUMP_STACK_SIZE=2048
